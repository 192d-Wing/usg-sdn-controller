{# AOS-CX — eBGP underlay on /127s + eBGP EVPN on loopbacks, multihop. #}
router bgp {{ node.asn }}
    router-id {{ node.router_id_v4 }}
    bgp log-neighbor-changes
    maximum-paths 8
    address-family ipv6 unicast
    exit-address-family
    address-family l2vpn evpn
        retain route-target all
    exit-address-family
{% for p in peers %}
    neighbor {{ p.remote_ipv6 }} remote-as {{ node_by_name[p.remote_node].asn }}
    neighbor {{ p.remote_ipv6 }} description "underlay to {{ p.remote_node }}"
    neighbor {{ node_by_name[p.remote_node].loopback_v6 }} remote-as {{ node_by_name[p.remote_node].asn }}
    neighbor {{ node_by_name[p.remote_node].loopback_v6 }} description "evpn to {{ p.remote_node }}"
    neighbor {{ node_by_name[p.remote_node].loopback_v6 }} update-source loopback0
    neighbor {{ node_by_name[p.remote_node].loopback_v6 }} ebgp-multihop 3
    address-family ipv6 unicast
        neighbor {{ p.remote_ipv6 }} activate
    exit-address-family
    address-family l2vpn evpn
        neighbor {{ node_by_name[p.remote_node].loopback_v6 }} activate
        neighbor {{ node_by_name[p.remote_node].loopback_v6 }} send-community extended
    exit-address-family
{% endfor %}
{% if node.is_vtep %}
!
overlay
    source-interface loopback0
    encapsulation vxlan
{% endif %}
