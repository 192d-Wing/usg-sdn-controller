{# Cisco IOS-XE — numbered IPv6 /127 p2p underlay + IS-IS L2 multi-topology. #}
hostname {{ node.name }}
ipv6 unicast-routing
no ip domain lookup

router isis FABRIC
 net {{ node.isis_net }}
 is-type level-2-only
 metric-style wide
 set-overload-bit on-startup 180
 address-family ipv6
  multi-topology
 exit-address-family

interface Loopback0
 description fabric loopback
 ipv6 address {{ node.loopback_v6 }}/128
 ipv6 enable
 ipv6 router isis FABRIC

{% for p in peers %}
interface {{ p.local_iface }}
 description {{ p.description }}
 no switchport
 mtu {{ fabric.mtu }}
 ipv6 address {{ p.local_ipv6 }}/{{ p.prefix_len }}
 ipv6 enable
 isis network point-to-point
 ipv6 router isis FABRIC
 no shutdown
{% endfor %}
