{# Cisco IOS-XE (Catalyst 9k / 8k) — IS-IS L2 IPv6, BGP with IPv6 link-local neighbors.
   IOS-XE does not have a true "neighbor <iface> remote-as external" syntax
   as in NX-OS; we configure explicit link-local neighbors keyed by interface. #}
hostname {{ node.name }}
ipv6 unicast-routing
no ip domain lookup

router isis FABRIC
 net {{ node.isis_net }}
 is-type level-2-only
 metric-style wide
 set-overload-bit on-startup 180
 address-family ipv6
  multi-topology
 exit-address-family

interface Loopback0
 description fabric loopback / VTEP
 ipv6 address {{ node.loopback_v6 }}/128
 ipv6 enable
 ipv6 router isis FABRIC

{% for p in peers %}
interface {{ p.local_iface }}
 description {{ p.description }}
 no switchport
 mtu {{ fabric.mtu }}
 ipv6 enable
 isis network point-to-point
 ipv6 router isis FABRIC
 no shutdown
{% endfor %}
