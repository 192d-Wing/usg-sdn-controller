{# Juniper Junos (EX/QFX) — numbered IPv6 /127 p2p underlay + IS-IS L2. #}
system {
    host-name {{ node.name }};
}
interfaces {
    lo0 {
        unit 0 {
            family inet6 {
                address {{ node.loopback_v6 }}/128;
            }
            family iso {
                address {{ node.isis_net }};
            }
        }
    }
{% for p in peers %}
    {{ p.local_iface }} {
        description "{{ p.description }}";
        mtu {{ fabric.mtu }};
        unit 0 {
            family inet6 {
                address {{ p.local_ipv6 }}/{{ p.prefix_len }};
            }
            family iso;
        }
    }
{% endfor %}
}
protocols {
    isis {
        reference-bandwidth 400g;
        level 1 disable;
        level 2 wide-metrics-only;
        interface lo0.0 {
            passive;
        }
{% for p in peers %}
        interface {{ p.local_iface }}.0 {
            point-to-point;
            level 2 metric 10;
        }
{% endfor %}
    }
}
routing-options {
    router-id {{ node.router_id_v4 }};
    autonomous-system {{ node.asn }};
    forwarding-table {
        chained-composite-next-hop {
            ingress {
                evpn;
            }
        }
    }
}
