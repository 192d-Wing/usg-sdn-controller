{# Junos overlay — eBGP underlay on /127 + eBGP EVPN on loopbacks (multihop). #}
policy-options {
    policy-statement LOOPBACK-EXPORT {
        term loopback {
            from {
                route-filter {{ node.loopback_v6 }}/128 exact;
            }
            then accept;
        }
        term connected {
            from protocol direct;
            then accept;
        }
        then reject;
    }
    policy-statement EVPN-IMPORT {
        then accept;
    }
}
protocols {
    bgp {
        group FABRIC-UNDERLAY {
            type external;
            mtu-discovery;
            local-as {{ node.asn }};
            multipath multiple-as;
            family inet6 unicast;
            export LOOPBACK-EXPORT;
{% for p in peers %}
            neighbor {{ p.remote_ipv6 }} {
                peer-as {{ node_by_name[p.remote_node].asn }};
                description "underlay to {{ p.remote_node }} ({{ p.remote_iface }})";
            }
{% endfor %}
        }
        group FABRIC-EVPN {
            type external;
            multihop {
                ttl 3;
            }
            local-as {{ node.asn }};
            local-address {{ node.loopback_v6 }};
            family evpn signaling;
{% for p in peers %}
            neighbor {{ node_by_name[p.remote_node].loopback_v6 }} {
                peer-as {{ node_by_name[p.remote_node].asn }};
                description "evpn to {{ p.remote_node }}";
            }
{% endfor %}
        }
    }
    evpn {
        encapsulation vxlan;
        extended-vni-list all;
        multicast-mode ingress-replication;
        default-gateway no-gateway-community;
    }
}
{% if node.is_vtep %}
switch-options {
    vtep-source-interface lo0.0;
    route-distinguisher {{ node.router_id_v4 }}:1;
    vrf-target target:{{ node.asn }}:0;
}
{% endif %}
