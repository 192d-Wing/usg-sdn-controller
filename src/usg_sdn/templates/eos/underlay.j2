{# Arista EOS — IS-IS L2 IPv6, BGP-unnumbered via "neighbor interface" #}
hostname {{ node.name }}
!
service routing protocols model multi-agent
!
ipv6 unicast-routing
!
interface Loopback0
   description fabric loopback / VTEP
   ipv6 address {{ node.loopback_v6 }}/128
   isis enable FABRIC
   isis passive
!
{% for p in peers %}
interface {{ p.local_iface }}
   description {{ p.description }}
   no switchport
   mtu {{ fabric.mtu }}
   ipv6 enable
   isis enable FABRIC
   isis network point-to-point
!
{% endfor %}
router isis FABRIC
   net {{ node.isis_net }}
   is-type level-2
   address-family ipv6 unicast
      multi-topology
