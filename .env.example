USG_SDN_DB_URL=sqlite+aiosqlite:///./usg-sdn.db
USG_SDN_LOG_LEVEL=INFO
USG_SDN_API_HOST=::
USG_SDN_API_PORT=8080
USG_SDN_RECONCILE_INTERVAL_SEC=60
USG_SDN_LINK_POOL_WARN_THRESHOLD=0.75
USG_SDN_LINK_POOL_GC=true

# --- auth ---------------------------------------------------------------
# When false (default), every request gets a synthetic "anonymous" principal
# with all scopes. Set to true in any non-dev environment.
USG_SDN_AUTH_ENABLED=false

# OIDC (optional — leave blank to use API tokens only)
USG_SDN_OIDC_ISSUER=
USG_SDN_OIDC_AUDIENCE=
USG_SDN_OIDC_JWKS_URL=
USG_SDN_OIDC_SCOPE_CLAIM=scope
USG_SDN_DEVICE_SSH_USER=sdn
USG_SDN_DEVICE_SSH_KEY=~/.ssh/id_ed25519
USG_SDN_AOSCX_USER=admin
USG_SDN_AOSCX_PASSWORD=changeme
